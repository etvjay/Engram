# CockroachDB application connection
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# AWS / Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary credentials
AWS_SESSION_TOKEN=
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Engram API deployment guard
# Required for every non-demo /v1 route. Do not expose this in a public browser bundle.
ENGRAM_API_TOKEN=

# CockroachDB Cloud Managed MCP (read/introspection plane)
COCKROACH_MCP_URL=https://cockroachlabs.cloud/mcp
COCKROACH_MCP_CLUSTER_ID=
COCKROACH_MCP_API_KEY=
COCKROACH_MCP_DATABASE=defaultdb

# API CORS
CORS_ORIGIN=*
